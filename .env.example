# Copy this file to .env.local for local development and configure in Vercel Project Settings for production.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# NextAuth (required for auth in production)
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Cloudinary (if image upload/display is used)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Maps (if live tracking/maps is used)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
